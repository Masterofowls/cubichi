{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": ".admin-dist"
  },
  "include": ["admin/**/*.ts", "scripts/**/*.ts", "src/types/**/*.ts"]
}
