# Public site metadata and API origin (set VITE_API_BASE_URL to empty for a same-origin reverse proxy)
SITE_URL=https://cubichi.ru
VITE_API_BASE_URL=https://api.cubichi.ru
FRONTEND_ORIGINS=https://cubichi.ru,https://www.cubichi.ru

# AdminJS credentials (use unique values; never deploy these example values)
ADMIN_USER=
ADMIN_PASS=
ADMIN_COOKIE_SECRET=
PORT=3001
ADMIN_PORT=3001
DATA_DIR=

# Mail.ru SMTP. Create an external-application password in the Mail.ru account settings.
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=gurevich_lena@mail.ru
SMTP_PASS=

# reg.ru ISPmanager FTP (npm run deploy:regru)
FTP_HOST=server279.hosting.reg.ru
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/www/cubichi.ru
