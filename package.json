    "check:biome": "biome check .",
    "check:biome:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "check": "npm run check:biome && npm run typecheck",
    "check:qlty": "qlty check -a",
    "admin": "npx tsx --tsconfig tsconfig.admin.json admin/server.ts",
    "generate-rss": "npx tsx --tsconfig tsconfig.admin.json scripts/generate-rss.ts",
    "export-posts": "tsx scripts/export-posts.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "motion": "^12.38.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@adminjs/bundler": "^3.0.0",
    "@adminjs/express": "^6.1.1",
    "@biomejs/biome": "^2.5.0",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "adminjs": "^7.8.17",
    "autoprefixer": "^10.4.20",
    "express": "^5.2.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.19.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.16",
    "tsx": "^4.22.4",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "@tiptap/extension-link": ">=2.10.4",
    "esbuild": ">=0.28.1",
    "i18next-http-backend": ">=3.0.5",
