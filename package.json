{
  "name": "cubichi",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run generate-rss && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node admin/server.js",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "check": "npm run lint && npm test",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --watch",
    "admin": "node admin/server.js",
    "generate-rss": "node scripts/generate-rss.js",
    "deploy:regru": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deploy-regru.ps1"
  },
  "dependencies": {
    "@adminjs/bundler": "^3.0.0",
    "@adminjs/express": "^6.1.1",
    "adminjs": "^7.8.17",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.19.0",
    "lucide-react": "^0.468.0",
    "motion": "^12.38.0",
    "nodemailer": "^7.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.1.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.4.20",
    "jest": "^30.0.5",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.10",
    "supertest": "^7.1.4",
    "tailwindcss": "^3.4.16",
    "vite": "^8.3.4"
  },
  "overrides": {
    "@tiptap/extension-link": ">=2.10.4",
    "esbuild": ">=0.28.1",
    "i18next-http-backend": ">=3.0.5",
    "tinymce": ">=7.9.3",
    "uuid": ">=11.1.1"
  }
}
