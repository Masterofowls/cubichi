{
  "name": "cubichi",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npx tsx --tsconfig tsconfig.admin.json scripts/generate-rss.ts && next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:biome": "biome lint .",
    "format": "biome format --write .",
